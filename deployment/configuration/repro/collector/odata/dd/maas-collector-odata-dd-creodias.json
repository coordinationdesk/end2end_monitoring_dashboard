{
    "collectors": [
        {
            "class": "ODataCollectorConfiguration",
            "id_field": [
                "product_id",
                "interface_name"
            ],
            "routing_key": "new.raw.data.dd-product",
            "interface_name": "DD_CREODIAS",
            "file_pattern": "DD_CREODIAS_*.json",
            "odata_query_filter": "Collection/Name eq 'SENTINEL-2' and PublicationDate ge {publication_start_date} and PublicationDate le {publication_end_date}",
            "refresh_interval": 10,
            "product_per_page": 1000,
            "model": "CreodiasProduct",
            "extractor": {
                "class": "JSONExtractor",
                "args": {
                    "attr_map": {
                        "product_id": "`this`.Id",
                        "product_name": "`this`.Name",
                        "content_length": "`this`.ContentLength",
                        "publication_date": "`this`.PublicationDate",
                        "start_date": "`this`.ContentDate.Start",
                        "end_date": "`this`.ContentDate.End",
                        "origin_date": "`this`.OriginDate",
                        "online": "`this`.Online",
                        "modification_date": "`this`.ModificationDate",
                        "footprint": "`this`.Footprint",
                        "s3_path": "`this`.S3Path",
                        "interface_name": {
                            "python": "lambda c: 'DD_CREODIAS'"
                        },
                        "production_service_type": {
                            "python": "lambda c: 'DD'"
                        },
                        "production_service_name": {
                            "python": "lambda c: 'CREODIAS'"
                        }
                    },
                    "iterate_nodes": "$.value",
                    "allow_partial": true
                }
            }
        }
    ]
}